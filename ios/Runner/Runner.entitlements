<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>production</string>
	<!-- Bắt buộc để mức "timeSensitive" trong DarwinNotificationDetails có tác
	     dụng thật — thiếu key này, thông báo đơn hàng mới bị Chế độ Tập
	     trung/Lái xe của iOS chặn hoàn toàn như thông báo thường. Cần bật
	     capability "Time Sensitive Notifications" tương ứng cho App ID trên
	     Apple Developer trước khi build, nếu không Xcode sẽ báo lỗi ký. -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
</dict>
</plist>
